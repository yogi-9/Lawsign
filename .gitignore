# =========================================================================
# LAWSIGN MASTER .GITIGNORE
# This file guarantees that no sensitive data, user documents, or 
# massive dependency folders are ever uploaded to GitHub.
# =========================================================================

# 1. Environment Secrets & API Keys
# Never upload API keys, Database URIs, or JWT secrets.
.env
.env.*
!.env.example
*.pem
*.key

# 2. User Data & Uploads
# CRITICAL: We must never upload users' legal documents or signatures!
backend/uploads/
uploads/
*.pdf
*.docx

# 3. Dependencies
# Do not upload Node packages. Let developers run 'npm install'.
node_modules/
backend/node_modules/
frontend/node_modules/

# 4. Compiled Frontend Code
# Vite builds to the 'dist' folder. This doesn't need to be tracked.
frontend/dist/
frontend/build/
dist/
build/

# 5. Logs and Debugging
# Server logs might contain sensitive data or crash reports.
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 6. Operating System & Editor Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
