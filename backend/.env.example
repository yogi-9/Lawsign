# ─────────────────────────────────────────────────────────────────
#  LawSign Backend — Environment Variables Template
#  Copy this file to .env and fill in real values
#  Never commit .env to version control
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────
# Option A: MongoDB Atlas (cloud)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lawsign?retryWrites=true&w=majority

# Option B: Local MongoDB
# MONGO_URI=mongodb://localhost:27017/lawsign

MONGO_URI=mongodb://localhost:27017/lawsign

# ── JWT ───────────────────────────────────────────────────────────
# CHANGE THIS in production — use a long random string (32+ chars)
JWT_SECRET=change_this_to_a_very_long_random_secret_before_deploying
JWT_EXPIRES_IN=7d

# ── Frontend (for CORS) ───────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Cookie ────────────────────────────────────────────────────────
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false
