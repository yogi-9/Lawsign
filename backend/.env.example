# ─────────────────────────────────────────────────────────────────
#  LawSign Backend — Environment Variables Template
#  Copy this file to .env and fill in real values
#  Never commit .env to version control
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────
# Option A: MongoDB Atlas (cloud — recommended for production)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/LawSign?retryWrites=true&w=majority

# Option B: Local MongoDB (for development)
MONGO_URI=mongodb://localhost:27017/LawSign

# Connection Pool Tuning
# maxPoolSize: max simultaneous connections to MongoDB (default: 10)
MONGO_MAX_POOL_SIZE=10
# minPoolSize: minimum connections kept open (default: 2)
MONGO_MIN_POOL_SIZE=2
# maxIdleTimeMS: close idle connections after this many ms (default: 30000)
MONGO_MAX_IDLE_TIME_MS=30000
# connectTimeoutMS: timeout for initial connection (default: 10000)
MONGO_CONNECT_TIMEOUT_MS=10000
# socketTimeoutMS: timeout for socket operations (default: 45000)
MONGO_SOCKET_TIMEOUT_MS=45000
# serverSelectionTimeoutMS: timeout for server selection (default: 5000)
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# heartbeatFrequencyMS: how often to check server status (default: 10000)
MONGO_HEARTBEAT_FREQUENCY_MS=10000
# retryWrites: automatically retry failed write operations (default: true)
MONGO_RETRY_WRITES=true
# debug: log all Mongoose queries to console — NEVER enable in production (default: false)
MONGO_DEBUG=false

# --- Third-Party Integrations ---
# Google OAuth 2.0 Credentials (for 'Sign in with Google')
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# NVIDIA API (for Vision Model Document/Signature validation)
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── JWT ───────────────────────────────────────────────────────────
# CHANGE THIS in production — use a long random string (32+ chars)
JWT_SECRET=change_this_to_a_very_long_random_secret_before_deploying
JWT_EXPIRES_IN=7d

# ── Frontend (for CORS) ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Cookie ────────────────────────────────────────────────────────
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false

# ── Audit ─────────────────────────────────────────────────────────
# Secret key for HMAC hashing of audit log entries (tamper detection)
# CHANGE THIS in production — use a long random string
AUDIT_SECRET=lawsign-audit-secret-change-in-production
