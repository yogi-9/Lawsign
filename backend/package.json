{
  "name": "lawsign-backend",
  "version": "1.0.0",
  "description": "LawSign — AI-powered legal document signing platform API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:debug": "nodemon --inspect server.js",
    "db:seed": "node seed.js",
    "db:seed:reset": "node seed.js --reset",
    "db:health": "node scripts/db-health.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:backup": "node scripts/db-backup.js",
    "db:restore": "node scripts/db-restore.js",
    "python:bg": "cd python && python bg_remover.py",
    "dev:full": "concurrently \"npm run dev\" \"npm run python:bg\""
  },
  "keywords": [
    "lawsign",
    "document-signing",
    "legal",
    "pdf",
    "api"
  ],
  "author": "LawSign Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.4.168",
    "sharp": "^0.33.4",
    "socket.io": "^4.7.5",
    "tesseract.js": "^7.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.0",
    "nodemon": "^3.1.3"
  },
  "nodemonConfig": {
    "watch": [
      "."
    ],
    "ext": "js,json",
    "ignore": [
      "uploads/*",
      "node_modules/*"
    ],
    "delay": "500"
  }
}
