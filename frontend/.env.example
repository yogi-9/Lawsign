# ==============================================================================
# LawSign Frontend - Environment Variables
# ==============================================================================

# ── API Connection ────────────────────────────────────────────────────────────
# The base URL for the backend API.
# In development with Vite's proxy, this can be relative (e.g., /api/v1).
# In production, it must be the absolute URL (e.g., https://api.lawsign.in/api/v1).
VITE_API_URL=/api/v1

# The URL for the Socket.io WebSocket connection.
# In development, it should point to the Vite proxy endpoint or backend directly.
# Default proxy routes /socket.io to backend automatically when using relative paths.
# If connecting cross-origin, provide the full URL (e.g., https://api.lawsign.in).
VITE_SOCKET_URL=/

# ── Application Environment ───────────────────────────────────────────────────
# Defines the current environment mode.
# Valid values: 'development' | 'production' | 'test'
# When set to 'development', features like verbose error messages, stack traces 
# in the UI Error Boundary, and enhanced console logging are enabled.
VITE_APP_ENV=development
